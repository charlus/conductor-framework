{
  "name": "conductor-framework",
  "version": "6.26.1",
  "description": "The Conductor — an AI Software Engineering framework for the full development lifecycle. Workflows, skills, and personas for AI-assisted product engineering.",
  "type": "module",
  "bin": {
    "conductor": "bin/conductor.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/with-test-tmp.mjs bash templates/.agents/tests/check-conductor.sh",
    "test:unit": "node scripts/with-test-tmp.mjs node --test test/*.test.js",
    "test:smoke": "node scripts/with-test-tmp.mjs bash test/smoke-loop.sh",
    "test:hooks": "node scripts/with-test-tmp.mjs bash test/hooks-eval-gate.sh",
    "test:trust": "node scripts/with-test-tmp.mjs bash test/hooks-trust-store.sh",
    "eval:routing": "node test/evals/routing-eval.mjs",
    "eval:routing:sensitivity": "node test/evals/routing-eval.mjs --mutate deepen.md --case deepen",
    "test:e2e": "node scripts/with-test-tmp.mjs bash test/e2e-loop-real.sh",
    "test:init": "node bin/conductor.js init /tmp/conductor-test-install --all && bash /tmp/conductor-test-install/.agents/tests/check-conductor.sh && rm -rf /tmp/conductor-test-install",
    "test:hooks:brief": "node scripts/with-test-tmp.mjs bash test/hooks-brief-gate.sh",
    "test:hooks:report": "node scripts/with-test-tmp.mjs bash test/hooks-report-gate.sh",
    "test:hooks:boundary": "node scripts/with-test-tmp.mjs bash test/hooks-boundary-gate.sh",
    "test:hooks:bypass": "node scripts/with-test-tmp.mjs bash test/hooks-no-bypass.sh",
    "test:conflict": "node scripts/with-test-tmp.mjs bash test/conflict-predict-real.sh",
    "test:hooks:factgate": "node scripts/with-test-tmp.mjs bash test/hooks-fact-gate.sh",
    "eval:factgate": "node test/evals/fact-gate-eval.mjs",
    "eval:factgate:sensitivity": "node test/evals/fact-gate-eval.mjs --sensitivity",
    "eval:livestate": "node test/evals/live-state-eval.mjs",
    "eval:livestate:sensitivity": "node test/evals/live-state-eval.mjs --sensitivity",
    "test:survey": "node scripts/with-test-tmp.mjs node --test test/survey.test.js",
    "test:hooks:waivers": "node scripts/with-test-tmp.mjs bash test/hooks-waiver-logging.sh",
    "test:hooks:nested": "node scripts/with-test-tmp.mjs bash test/hooks-nested-repos.sh",
    "test:hooks:nocode": "node scripts/with-test-tmp.mjs bash test/hooks-no-code.sh",
    "test:hooks:merge": "node scripts/with-test-tmp.mjs bash test/hooks-merge-upgrade.sh",
    "test:hooks:stable": "node scripts/with-test-tmp.mjs bash test/hooks-verify-stable-tree.sh"
  },
  "keywords": [
    "conductor",
    "ai",
    "framework",
    "agent",
    "ase",
    "software-engineering",
    "workflows",
    "skills",
    "personas",
    "gemini",
    "claude",
    "antigravity"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-USERNAME/conductor-framework"
  }
}

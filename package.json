{
  "name": "conductor-framework",
  "version": "6.4.0",
  "description": "The Conductor — an AI Software Engineering framework for the full development lifecycle. Workflows, skills, and personas for AI-assisted product engineering.",
  "type": "module",
  "bin": {
    "conductor": "bin/conductor.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bash templates/.agents/tests/check-conductor.sh",
    "test:unit": "node --test test/*.test.js",
    "test:smoke": "bash test/smoke-loop.sh",
    "test:hooks": "bash test/hooks-eval-gate.sh",
    "test:trust": "bash test/hooks-trust-store.sh",
    "eval:routing": "node test/evals/routing-eval.mjs",
    "eval:routing:sensitivity": "node test/evals/routing-eval.mjs --mutate deepen.md --case deepen",
    "test:e2e": "bash test/e2e-loop-real.sh",
    "test:init": "node bin/conductor.js init /tmp/conductor-test-install --all && bash /tmp/conductor-test-install/.agents/tests/check-conductor.sh && rm -rf /tmp/conductor-test-install",
    "test:hooks:brief": "bash test/hooks-brief-gate.sh",
    "test:hooks:report": "bash test/hooks-report-gate.sh",
    "test:hooks:boundary": "bash test/hooks-boundary-gate.sh",
    "test:hooks:bypass": "bash test/hooks-no-bypass.sh",
    "test:conflict": "bash test/conflict-predict-real.sh"
  },
  "keywords": [
    "conductor",
    "ai",
    "framework",
    "agent",
    "ase",
    "software-engineering",
    "workflows",
    "skills",
    "personas",
    "gemini",
    "claude",
    "antigravity"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-USERNAME/conductor-framework"
  }
}

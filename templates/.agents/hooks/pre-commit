#!/usr/bin/env bash
# Conductor — Test-Driven Law + Eval-Driven Law, deterministically enforced (ADR-0001 D1).
#   TDD:  implementation change with no accompanying test change is rejected.
#   Eval: LLM-feature code (calls a provider) with no accompanying eval is rejected.
#   Brief: a feature-spec with no "Brief check" section is rejected (A5 / D1).
#   Report: a ship-log whose newest entry has no "For you" block is rejected (A4).
# The two gates are INDEPENDENT — waiving one never skips the other. LLM-feature
# code needs BOTH a test (deterministic glue) and an eval (non-deterministic output).
# Escape hatches (logged, never silent): CONDUCTOR_NO_TEST / CONDUCTOR_NO_EVAL /
# CONDUCTOR_NO_BRIEF / CONDUCTOR_NO_REPORT, each ="reason".
# Disable everything: CONDUCTOR_HOOKS=off.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$ROOT" ] && exit 0
# shellcheck source=/dev/null
. "$ROOT/.agents/hooks/lib.sh"

[ "${CONDUCTOR_HOOKS:-on}" = "off" ] && exit 0

# Nothing staged at all is the only early exit. The gates below must still see
# a commit that ONLY removes files: it stages nothing under ACM, and that is
# exactly the shape of the cheapest Goodhart move ("delete the failing test")
# and of disabling a gate by deleting it. Filtering to ACM up here is how both
# stayed invisible.
[ -z "$(git diff --cached --name-only)" ] && exit 0

staged="$(git diff --cached --name-only --diff-filter=ACM)"
deleted_tests="$(conductor_deleted_test_files "$ROOT")"

impl=0; tests=0; impl_files=""
llm=0;  evals=0; llm_files=""
brief=0; brief_files=""
report=0; report_files=""
staged_tests=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if conductor_is_test_file "$f"; then
    tests=1
    staged_tests+=("$f")
  elif conductor_is_impl_file "$f"; then
    impl=1
    impl_files="$impl_files\n    - $f"
  fi
  if conductor_is_ship_log "$f" && ! conductor_newest_entry_has_for_you "$ROOT/$f"; then
    report=1
    report_files="$report_files\n    - $f"
  fi
  if conductor_is_brief_doc "$f" && ! conductor_has_brief_check "$ROOT/$f"; then
    brief=1
    brief_files="$brief_files\n    - $f"
  fi
  if conductor_is_eval_file "$f"; then
    evals=1
  elif conductor_is_llm_feature_file "$ROOT/$f"; then
    llm=1
    llm_files="$llm_files\n    - $f"
  fi
done <<< "$staged"

blocked=0

# ---- Test-Driven Law ------------------------------------------------------
if [ "$impl" = "1" ] && [ "$tests" = "0" ]; then
  if [ -n "${CONDUCTOR_NO_TEST:-}" ]; then
    conductor_log_waiver "$ROOT" "TDD" "$CONDUCTOR_NO_TEST"
    echo "⚠️  Conductor Test-Driven Law WAIVED: $CONDUCTOR_NO_TEST"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor Test-Driven Law — commit blocked."
    echo ""
    echo "  You are committing implementation code with no test change:"
    echo -e "$impl_files"
    echo ""
    echo "  Red before green. Either:"
    echo "    • stage the failing/covering test alongside the code, or"
    echo "    • if this genuinely has no test surface (config, generated code),"
    echo "      record the reason:  CONDUCTOR_NO_TEST=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

# ---- The Goodhart boundary ------------------------------------------------
# Independent of the TDD gate above: CONDUCTOR_NO_TEST says "this change has no
# test surface", which is not a licence to remove proof that already exists.
boundary_why=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  boundary_why="$boundary_why\n    - test file DELETED: $f"
done <<< "$deleted_tests"

if [ "${#staged_tests[@]}" -gt 0 ]; then
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    boundary_why="$boundary_why\n    - test DISABLED: $hit"
  done <<< "$(conductor_added_skip_markers "$ROOT" "${staged_tests[@]}")"

  delta="$(conductor_assertion_delta "$ROOT" "${staged_tests[@]}")"
  if [ "$delta" -lt 0 ]; then
    boundary_why="$boundary_why\n    - assertions REMOVED: net $delta across the staged tests"
  fi
fi

if [ -n "$boundary_why" ]; then
  if [ -n "${CONDUCTOR_NO_BOUNDARY:-}" ]; then
    conductor_log_waiver "$ROOT" "Boundary" "$CONDUCTOR_NO_BOUNDARY"
    echo "⚠️  Conductor Goodhart boundary WAIVED: $CONDUCTOR_NO_BOUNDARY"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor Goodhart boundary — commit blocked."
    echo ""
    echo "  This commit makes the test suite prove less than it did:"
    echo -e "$boundary_why"
    echo ""
    echo "  'All tests pass' only means something while the tests still test."
    echo "  Deleting, skipping or gutting a failing test reaches green without"
    echo "  fixing anything, so the gate treats it as the defect it is. Either:"
    echo "    • fix the code the test was holding to account, or"
    echo "    • if the behaviour is genuinely gone (feature removed, test"
    echo "      merged elsewhere, assertion moved), say so:"
    echo "      CONDUCTOR_NO_BOUNDARY=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

# ---- Protected paths ------------------------------------------------------
protected_files=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  protected_files="$protected_files\n    - $f"
done <<< "$(conductor_protected_changes "$ROOT")"

if [ -n "$protected_files" ]; then
  if [ -n "${CONDUCTOR_NO_PROTECTED:-}" ]; then
    conductor_log_waiver "$ROOT" "Protected" "$CONDUCTOR_NO_PROTECTED"
    echo "⚠️  Conductor protected paths WAIVED: $CONDUCTOR_NO_PROTECTED"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor protected paths — commit blocked."
    echo ""
    echo "  This commit edits the enforcement surface itself:"
    echo -e "$protected_files"
    echo ""
    echo "  The hooks, the always-on rules, the sandbox profile and the reviewer"
    echo "  brief are the acceptance conditions. Whatever is being built does not"
    echo "  get to edit what decides whether it passes. Either:"
    echo "    • make the change you actually meant, outside these paths, or"
    echo "    • if you are deliberately changing the rules (a 'conductor"
    echo "      upgrade', or a decision you have made), say so:"
    echo "      CONDUCTOR_NO_PROTECTED=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

# ---- Eval-Driven Law ------------------------------------------------------
if [ "$llm" = "1" ] && [ "$evals" = "0" ]; then
  if [ -n "${CONDUCTOR_NO_EVAL:-}" ]; then
    conductor_log_waiver "$ROOT" "Eval" "$CONDUCTOR_NO_EVAL"
    echo "⚠️  Conductor Eval-Driven Law WAIVED: $CONDUCTOR_NO_EVAL"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor Eval-Driven Law — commit blocked."
    echo ""
    echo "  You are committing code that calls an LLM with no eval change:"
    echo -e "$llm_files"
    echo ""
    echo "  Tests verify the deterministic parts; evals verify the non-deterministic"
    echo "  LLM output. A passing unit test is not enough. Either:"
    echo "    • stage an evalset alongside the code (evals/… or *.eval.*) — see the"
    echo "      writing-evals skill for the three grading modes (rubric/judge,"
    echo "      property, reference), or"
    echo "    • if this has no eval surface (a stub, plumbing, config),"
    echo "      record the reason:  CONDUCTOR_NO_EVAL=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

# ---- Outward Rigour: the brief check ---------------------------------------
if [ "$brief" = "1" ]; then
  if [ -n "${CONDUCTOR_NO_BRIEF:-}" ]; then
    conductor_log_waiver "$ROOT" "Brief" "$CONDUCTOR_NO_BRIEF"
    echo "⚠️  Conductor brief check WAIVED: $CONDUCTOR_NO_BRIEF"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor brief check — commit blocked."
    echo ""
    echo "  This spec records no brief check:"
    echo -e "$brief_files"
    echo ""
    echo "  Before building, the brief is checked against four conditions:"
    echo "    C1 it contradicts a decision the human made earlier"
    echo "    C2 it breaks something for existing users"
    echo "    C3 its cost or duration is far from what the brief assumes"
    echo "    C4 we lack the data, the access or the rights"
    echo ""
    echo "  Add a '## Brief check' section with what you found, or 'None found.'"
    echo "  It is not a veto — state it, let the human answer, keep building."
    echo "    • carried over from a pre-A5 spec? record the reason:"
    echo "      CONDUCTOR_NO_BRIEF=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

# ---- The report shape: what the human actually reads ----------------------
if [ "$report" = "1" ]; then
  if [ -n "${CONDUCTOR_NO_REPORT:-}" ]; then
    conductor_log_waiver "$ROOT" "Report" "$CONDUCTOR_NO_REPORT"
    echo "⚠️  Conductor report shape WAIVED: $CONDUCTOR_NO_REPORT"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor report shape — commit blocked."
    echo ""
    echo "  This ship-log's newest entry has no '**For you**' block:"
    echo -e "$report_files"
    echo ""
    echo "  The human may read this on another machine, hours later, with no"
    echo "  session context. Four lines, before the record:"
    echo "    - **Impact:** what a user can now do, or stops suffering"
    echo "    - **Cost:**   what this adds to running the product, or none"
    echo "    - **Risk:**   what could still bite, or none"
    echo "    - **Decide:** the one thing only they can answer, or none"
    echo ""
    echo "  'none' is a valid answer to all four. An invented line is not."
    echo "    • editing an old entry, not shipping? record the reason:"
    echo "      CONDUCTOR_NO_REPORT=\"why\" git commit …"
    echo ""
    blocked=1
  fi
fi

exit "$blocked"

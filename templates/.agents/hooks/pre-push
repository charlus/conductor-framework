#!/usr/bin/env bash
# Conductor — Verification Iron Law + Eval-Driven Law (run-gate), enforced at the
# push boundary (ADR-0001 D1). Verify: the project's verification command must pass.
# Eval: if the repo has evalsets and an eval command, they must pass too — presence
# was gated at commit; passing is gated here. No "should work" — proof or no push.
# Escapes (logged): CONDUCTOR_SKIP_VERIFY / CONDUCTOR_SKIP_EVAL. Disable: CONDUCTOR_HOOKS=off.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$ROOT" ] && exit 0
[ "${CONDUCTOR_HOOKS:-on}" = "off" ] && exit 0

# git feeds one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>.
PUSH_LINES="$(cat)"
ZERO="0000000000000000000000000000000000000000"

# ---- Load the shared library from a copy the change cannot rewrite ----------
# Both hooks source lib.sh, which makes it the single point that switches every
# gate off. Two versions of this got it wrong, both found by independent review:
#   1. sourcing the WORKING-TREE copy: deleting, moving or rewriting lib.sh
#      disabled every gate for the very commit doing it (round 1, B1);
#   2. sourcing the working-tree copy FIRST and the committed copy on top: any
#      top-level statement still ran — one `exit 0` switched everything off,
#      and `readonly -f` stopped the trusted copy redefining a helper (delta).
# So: once a lib.sh is COMMITTED, only the committed copy is sourced. The
# working-tree copy is never executed. It is used only when nothing has been
# committed yet — a fresh install, where there is no gate to weaken.
#
# The limit, stated rather than implied: this protects the LIBRARY. git runs the
# hook ENTRY SCRIPTS (pre-commit, pre-push) from the working tree, so a change
# that rewrites both runs the rewritten versions. Removing or disabling
# pre-commit is caught at pre-push below; rewriting both entry scripts defeats
# every client-side hook, and the backstop for that is the PR gate and the
# loop's Checker, not this file.
conductor_load_lib() {
  local ref="$1" tmp
  if [ -n "$ref" ] && git -C "$ROOT" cat-file -e "$ref:.agents/hooks/lib.sh" 2>/dev/null; then
    tmp="$(mktemp 2>/dev/null)" || return 1
    if ! git -C "$ROOT" show "$ref:.agents/hooks/lib.sh" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    # shellcheck source=/dev/null
    . "$tmp"
    rm -f "$tmp"
    return 0
  fi
  [ -f "$ROOT/.agents/hooks/lib.sh" ] || return 1
  # shellcheck source=/dev/null
  . "$ROOT/.agents/hooks/lib.sh"
}

# Every helper `$1` needs, or the names that are missing. A committed lib.sh
# older than this hook (mid-upgrade) lacks the newer helpers; running on with
# them undefined would silently skip their gates, so a gap fails closed instead.
conductor_missing_helpers() {
  local fn missing=""
  for fn in $1; do
    type "$fn" >/dev/null 2>&1 || missing="$missing $fn"
  done
  printf '%s' "${missing# }"
}

# Minimal ship-log writer for the one path where lib.sh could not be loaded,
# so even that waiver is recorded rather than silent.
conductor_log_waiver_fallback() {
  local log="$ROOT/conductor/0-compass/ship-log.md"
  [ -f "$log" ] || return 0
  printf -- '- [%s] Hook waiver (%s): %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" "$2" >> "$log"
}

# The trusted copy is what the REMOTE already has: at push time HEAD is the
# very commit being judged. Fall back to HEAD only when the remote has nothing.
TRUSTED_REF=""
while read -r _lref _lsha _rref rsha; do
  if [ -n "${rsha:-}" ] && [ "$rsha" != "$ZERO" ] && git -C "$ROOT" cat-file -e "$rsha" 2>/dev/null; then
    TRUSTED_REF="$rsha"
    break
  fi
done <<< "$PUSH_LINES"
# A brand-new branch has no remote sha: trust its merge-base with anything a
# remote already has, and HEAD only when there is no remote history at all.
if [ -z "$TRUSTED_REF" ]; then
  for r in $(git -C "$ROOT" for-each-ref --format='%(objectname)' refs/remotes 2>/dev/null); do
    mb="$(git -C "$ROOT" merge-base HEAD "$r" 2>/dev/null)" && [ -n "$mb" ] && { TRUSTED_REF="$mb"; break; }
  done
fi
[ -z "$TRUSTED_REF" ] && git -C "$ROOT" rev-parse --verify -q HEAD >/dev/null 2>&1 && TRUSTED_REF="HEAD"

REQUIRED="conductor_verify_cmd conductor_eval_cmd conductor_has_eval_files conductor_log_waiver"
lib_ok=1
conductor_load_lib "$TRUSTED_REF" || lib_ok=0
missing="$(conductor_missing_helpers "$REQUIRED")"

if [ "$lib_ok" = "0" ] || [ -n "$missing" ]; then
  # Nothing loadable. If the remote had Conductor, this push is removing it.
  if [ -n "$TRUSTED_REF" ] && git -C "$ROOT" cat-file -e "$TRUSTED_REF:.agents/hooks/lib.sh" 2>/dev/null; then
    if [ -n "${CONDUCTOR_NO_PROTECTED:-}" ]; then
      conductor_log_waiver_fallback "Protected" "$CONDUCTOR_NO_PROTECTED"
      echo "⚠️  Conductor enforcement library unavailable — WAIVED: $CONDUCTOR_NO_PROTECTED"
      exit 0
    fi
    echo "🛑 Conductor — the committed enforcement library cannot run this hook; push blocked."
    echo "   If you are deliberately removing or upgrading Conductor: CONDUCTOR_NO_PROTECTED=\"why\" git push …"
    exit 1
  fi
  exit 0
fi

# ---- A gate that could not judge its own removal ---------------------------
# git runs pre-commit from the working tree, so a commit that DELETES it runs
# no commit gate at all (independent review, blocker B1). This is the first
# boundary left that can see it: refuse to push a range that deletes a hook
# entry script unless the removal is stated.
removed_hooks=""
# Read the RAW diff so a rename and a mode change are visible, not only a
# deletion: `git mv pre-commit pre-commit.disabled` is status R, and
# `chmod -x pre-commit` is a mode change git obeys by silently skipping the
# hook. Both disable it as surely as deleting it (delta review, B1).
#
# An EDITED pre-commit counts too (final review, NB1): git runs the edited
# copy, so a pre-commit rewritten to `exit 0` judged its own commit and passed
# it — with a deleted test in the same commit. The two entry scripts cover each
# other: pre-commit (running the committed library) blocks an edit to pre-push
# at commit time, and pre-push blocks an edit to pre-commit here. Editing BOTH
# defeats any client-side hook; that is the stated limit.
hook_changes() {
  git -C "$ROOT" diff --raw -M "$1" "$2" -- .agents/hooks/ 2>/dev/null | awk -F'\t' '
    { split($1, m, " "); nm = m[2]; st = substr(m[5], 1, 1); p = $2; q = $3
      if (st == "D") print p " (deleted)"
      else if (st == "R") print p " (renamed to " q ")"
      else if (p ~ /\/pre-(commit|push)$/ && (st == "T" || nm != "100755")) print p " (no longer executable)"
      else if (p ~ /\/pre-commit$/ && st == "M") print p " (edited — the edited copy judged its own commit)" }'
}
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] || [ "$lsha" = "$ZERO" ] && continue
  from="$rsha"
  [ -z "${from:-}" ] || [ "$from" = "$ZERO" ] && from="$TRUSTED_REF"
  [ -z "$from" ] && continue
  while IFS= read -r f; do
    [ -n "$f" ] && removed_hooks="$removed_hooks\n    - $f"
  done <<< "$(hook_changes "$from" "$lsha")"
done <<< "$PUSH_LINES"

if [ -n "$removed_hooks" ]; then
  if [ -n "${CONDUCTOR_NO_PROTECTED:-}" ]; then
    conductor_log_waiver "$ROOT" "Protected" "$CONDUCTOR_NO_PROTECTED"
    echo "⚠️  Conductor hook removal WAIVED: $CONDUCTOR_NO_PROTECTED"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo ""
    echo "🛑 Conductor — this push removes or disables an enforcement hook; push blocked."
    echo -e "$removed_hooks"
    echo ""
    echo "  A deleted pre-commit runs no commit gate at all, so the commit that"
    echo "  removed it was never judged. If the removal is deliberate, say so:"
    echo "    CONDUCTOR_NO_PROTECTED=\"why\" git push …"
    echo ""
    exit 1
  fi
fi

# ---- Verification Iron Law ------------------------------------------------
cmd="$(conductor_verify_cmd "$ROOT")"
if [ "$cmd" = "none" ]; then
  # A DECLARED off (`conductor verify --none`). Silent on purpose: a docs or
  # state repo has nothing to run, and a warning it can never clear is how a
  # safety message gets trained out of the reader.
  :
elif [ -z "$cmd" ]; then
  echo "ℹ️  Conductor: push gate OFF — no verification command, so this push proves nothing."
  echo "    Set it:        conductor verify --set \"npm test\"    (the command that proves this project works)"
  echo "    Or declare it: conductor verify --none               (nothing to verify in this repo)"
elif [ -n "${CONDUCTOR_SKIP_VERIFY:-}" ]; then
  conductor_log_waiver "$ROOT" "VERIFY" "$CONDUCTOR_SKIP_VERIFY"
  echo "⚠️  Conductor Verification Iron Law WAIVED: $CONDUCTOR_SKIP_VERIFY"
  echo "    (logged to conductor/0-compass/ship-log.md)"
else
  # ---- Evidence ledger fast path (E2) ------------------------------------
  # If this EXACT command already ran green against this EXACT working-tree
  # content, re-running it proves nothing new. `conductor evidence check` binds
  # freshness to a content fingerprint, so committing the tested code keeps its
  # evidence FRESH while any source change invalidates it.
  #
  # Strictly opt-out and strictly fail-safe: no `conductor` on PATH, no ledger,
  # any doubt at all → we run the command. The ledger can only ever SKIP a
  # redundant run; it can never satisfy the gate on its own.
  fresh=0
  if [ "${CONDUCTOR_EVIDENCE:-on}" != "off" ] && command -v conductor >/dev/null 2>&1; then
    # Allow-list: a release-note or version edit between the test run and the
    # push is not a behaviour change. Deliberately SMALL and never a source
    # path — override with CONDUCTOR_EVIDENCE_ALLOW_PATHS if your release flow
    # touches other non-source files.
    allow="${CONDUCTOR_EVIDENCE_ALLOW_PATHS:-CHANGELOG.md,VERSION}"
    if ( cd "$ROOT" && conductor evidence check --label verify --expect-cmd "$cmd" --allow-paths "$allow" >/dev/null 2>&1 ); then
      fresh=1
    fi
  fi

  if [ "$fresh" = "1" ]; then
    echo "✅ Verification FRESH — this exact command already passed against this exact content."
    echo "   (evidence ledger; re-run anyway with CONDUCTOR_EVIDENCE=off)"
  else
    echo "🔬 Conductor Verification Iron Law — running: $cmd"
    # Wrap the run so the result is recorded and the next push can trust it.
    # The wrapper is transparent: the command's exit code is the wrapper's, so
    # this can never turn a red suite green or a green suite red.
    if [ "${CONDUCTOR_EVIDENCE:-on}" != "off" ] && command -v conductor >/dev/null 2>&1; then
      runner() { ( cd "$ROOT" && conductor evidence run --label verify -- "$cmd" ); }
    else
      runner() { ( cd "$ROOT" && eval "$cmd" ); }
    fi
    if runner; then
      echo "✅ Verification passed."
    else
      echo ""
      echo "🛑 Verification FAILED — push blocked."
      echo "   Fix it, or bypass explicitly: CONDUCTOR_SKIP_VERIFY=\"why\" git push …"
      exit 1
    fi
  fi
fi

# ---- Eval-Driven Law (run-gate) -------------------------------------------
# Presence was enforced at commit; here the evalsets must actually pass. Only
# engages when the repo has evalsets — non-LLM projects never see it.
if conductor_has_eval_files "$ROOT"; then
  eval_cmd="$(conductor_eval_cmd "$ROOT")"
  if [ -z "$eval_cmd" ]; then
    echo "ℹ️  Conductor: evalsets exist but no eval command is configured — the Eval-Driven Law run-gate is NOT enforced on this push. Add \"eval\" to conductor.config.json (e.g. \"eval\": \"python -m pytest evals/ -q\") or an \"eval\" npm script."
  elif [ -n "${CONDUCTOR_SKIP_EVAL:-}" ]; then
    conductor_log_waiver "$ROOT" "EVAL" "$CONDUCTOR_SKIP_EVAL"
    echo "⚠️  Conductor Eval-Driven Law (run) WAIVED: $CONDUCTOR_SKIP_EVAL"
    echo "    (logged to conductor/0-compass/ship-log.md)"
  else
    echo "🧪 Conductor Eval-Driven Law — running evals: $eval_cmd"
    if ( cd "$ROOT" && eval "$eval_cmd" ); then
      echo "✅ Evals passed."
    else
      echo ""
      echo "🛑 Evals FAILED — push blocked."
      echo "   Tests being green is not enough — the non-deterministic surface regressed."
      echo "   Fix the evalset, or bypass explicitly: CONDUCTOR_SKIP_EVAL=\"why\" git push …"
      exit 1
    fi
  fi
fi

echo "✅ Push allowed."
exit 0

#!/usr/bin/env node
// A stand-in for the `claude` CLI, for test/loop-stage-conformance.test.js.
// It saves every prompt it gets to $STUB_LOG_DIR (so the test can see which
// workflow each beat was routed to), then does the least work that passes the
// beat's gate: the stage's document, the slice's spec, a code file, Ship's
// bookkeeping, or an approving verdict. $STUB_SKIP names one stage key whose
// beat writes nothing, so the test can watch that gate reject it.
import { appendFileSync, mkdirSync, writeFileSync, readFileSync, existsSync, renameSync, readdirSync } from "node:fs";
import { join, dirname } from "node:path";
import { execFileSync } from "node:child_process";

const argv = process.argv.slice(2);
if (argv[0] === "--version") {
  console.log("2.9.0 (stub)");
  process.exit(0);
}
const prompt = argv[argv.length - 1] ?? "";
const dir = process.env.STUB_LOG_DIR;
if (dir) {
  mkdirSync(dir, { recursive: true });
  const n = String(readdirSync(dir).filter((f) => f.endsWith(".txt")).length).padStart(3, "0");
  writeFileSync(join(dir, `${n}.txt`), prompt);
  // The --model this beat was started with, for the profile test.
  const m = argv.indexOf("--model");
  writeFileSync(join(dir, `${n}.model`), m >= 0 ? argv[m + 1] : "default");
  // The provider keys this beat could see, for the P4 blank-env test.
  writeFileSync(join(dir, `${n}.env.json`), JSON.stringify({ GEMINI_API_KEY: process.env.GEMINI_API_KEY ?? null, ANTHROPIC_API_KEY: process.env.ANTHROPIC_API_KEY ?? null }));
}
// I2: $STUB_LIMIT_ONCE names a marker file. The first beat prints Claude's
// usage-limit banner with a reset two seconds ahead, does nothing, and exits 1.
if (process.env.STUB_LIMIT_ONCE && !existsSync(process.env.STUB_LIMIT_ONCE)) {
  writeFileSync(process.env.STUB_LIMIT_ONCE, "1");
  console.log(`Claude AI usage limit reached|${Math.round(Date.now() / 1000) + 2}`);
  process.exit(1);
}
// I3: $STUB_RACE_OUTER (a bare repository) — during the first Ship beat, someone
// else's change to the ship-log lands on its master. $STUB_RACE_CODE (the code
// bare repository) — the same, on app.py of its main, and every build edits app.py.
function race(bare, branch, rel, line) {
  const tmp = join(process.env.STUB_LOG_DIR ?? ".", `race-${Date.now()}`);
  execFileSync("git", ["clone", "-q", "-b", branch, bare, tmp], { stdio: "pipe" });
  appendFileSync(join(tmp, rel), line);
  execFileSync("git", ["-C", tmp, "-c", "user.email=o@o", "-c", "user.name=o", "commit", "-qam", "someone else"], { stdio: "pipe" });
  execFileSync("git", ["-C", tmp, "push", "-q", "origin", branch], { stdio: "pipe" });
}
const put = (rel, text) => {
  mkdirSync(dirname(rel), { recursive: true });
  writeFileSync(rel, text);
};
const field = (label) => prompt.match(new RegExp(`\\*\\*${label}:\\*\\* \`([^\`]+)\``))?.[1];
const done = () => put("conductor/1-workbench/maker-signal.json", '{ "done": true }');
const body = "## What changes for you\nstub\n\n## Decisions I took alone\nnone\n\n## Evidence\nstub\n\n## What I need from you\nmerge\n";
const doc = (title) => `# ${title}\n\nWritten by the stub engine for the conformance test.\n`;
const skip = process.env.STUB_SKIP;

const checker = existsSync(".agents/workflows/loop-checker.md") && prompt.startsWith(readFileSync(".agents/workflows/loop-checker.md", "utf8"));
if (checker) {
  put("conductor/1-workbench/checker-verdict.json", JSON.stringify({ approved: true, reason: "stub approves", findings: [] }));
} else if (prompt.includes("# Blueprint assignment (this beat)")) {
  const project = field("Project folder");
  const key = prompt.match(/\*\*Stage:\*\* ([a-z-]+)/)[1];
  if (key !== skip) {
    const out = { "grand-prd": "grand-prd.md", "ux-ui-brief": "ux-ui-design-brief.md", "technical-vision": "technical-vision.md", carve: "implementation-overview.md" }[key];
    put(join(project, "blueprint", out), doc(key));
    if (key === "ux-ui-brief") put("DESIGN.md", doc("DESIGN"));
    if (key === "carve") {
      const tpl = (n) => readFileSync(join("conductor/5-templates/carve-workflow", n), "utf8");
      // $STUB_SLICES: how many slices the Carve makes (default 1, "01-first").
      const n = Number(process.env.STUB_SLICES ?? 1);
      const names = n === 1 ? ["01-first"] : Array.from({ length: n }, (_, i) => `0${i + 1}-slice-${i + 1}`);
      for (const s of names) {
        put(join(project, `implementations/${s}/feature-spec.md`), tpl("feature-spec.md"));
        put(join(project, `implementations/${s}/implementation-plan.md`), tpl("implementation-plan.md"));
      }
      put(join(project, "project-documentation.md"), `# Project documentation\n\n${names.map((s) => `## ${s}\nA slice.\n`).join("\n")}`);
      put("conductor/1-workbench/pr-body.md", body);
    }
    done();
  }
} else if (prompt.includes("# Spec assignment (this beat)")) {
  const slice = field("Slice folder");
  put(join(slice, "feature-spec.md"), "# Feature Spec\n\n## Brief check\n\n- **C1:** None found.\n\n## Stories\n- one\n");
  put(join(slice, "implementation-plan.md"), "# Plan\n\n- step 1\n");
  done();
} else if (prompt.includes("# Ship assignment (this beat)")) {
  const from = prompt.match(/move `([^`]+)` to `([^`]+)`/);
  if (from) {
    mkdirSync(dirname(from[2]), { recursive: true });
    renameSync(from[1], from[2]);
  }
  if (prompt.includes("**Tick it in this branch:**")) {
    const b = "conductor/2-backlog/task-backlog.md";
    writeFileSync(b, readFileSync(b, "utf8").replace(/- \[ \] (.*?) \(loop-ready\)/, "- [x] $1 **Done 2026-10-20** stub"));
  }
  appendFileSync("conductor/0-compass/ship-log.md", "\n## 2026-10-20 — stub ship\n\n**For you**\n- **Impact:** a\n- **Cost:** none\n- **Risk:** none\n- **Decide:** none\n");
  // The KM relief case: this ship and another project's both edit a prose document.
  if (process.env.STUB_RACE_OUTER) appendFileSync("conductor/4-context/meta/glossary.md", "\n- KM: knowledge manager, written by this slice\n");
  const mark = join(process.env.STUB_LOG_DIR ?? ".", "raced");
  if (!existsSync(mark) && (process.env.STUB_RACE_OUTER || process.env.STUB_RACE_CODE)) {
    writeFileSync(mark, "1");
    if (process.env.STUB_RACE_OUTER) race(process.env.STUB_RACE_OUTER, "master", "conductor/4-context/meta/glossary.md", "\n- CoP: a community of practice, written by another project\n");
    if (process.env.STUB_RACE_CODE) race(process.env.STUB_RACE_CODE, "main", "app.py", "y = 'someone else'\n");
  }
  put("conductor/1-workbench/pr-body.md", body);
  done();
} else if (prompt.includes("# Loop Assignment (this beat)")) {
  // In the outer layout ($STUB_CODE_DIR) the code goes into the nested repository.
  // Each build writes a new file, so a slice stacked on another still has code of its own.
  const src = join(process.env.STUB_CODE_DIR ?? ".", "src");
  const taken = existsSync(src) ? readdirSync(src).filter((f) => f.startsWith("built")).length : 0;
  put(join(src, taken ? `built-${taken + 1}.js` : "built.js"), "export const built = true;\n");
  if (process.env.STUB_RACE_CODE) appendFileSync(join(process.env.STUB_CODE_DIR ?? ".", "app.py"), "y = 'the slice'\n");
  // I4: $STUB_DEP is "<manifest>:<line>": the build adds that dependency line once.
  if (process.env.STUB_DEP) {
    const [file, line] = process.env.STUB_DEP.split(":");
    const m = join(process.env.STUB_CODE_DIR ?? ".", file);
    const text = existsSync(m) ? readFileSync(m, "utf8") : "";
    if (!text.includes(line)) appendFileSync(m, `${line}\n`);
  }
  done();
}
console.log(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: "stub", usage: { input_tokens: 1, output_tokens: 1 } }));
